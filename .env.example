# Copy to .env.local for local development, and add the same names in Vercel
# (Project → Settings → Environment Variables). See ADMIN_SETUP.md. Never commit values.

# Auth.js
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Who may use /admin: numeric GitHub user IDs, comma-separated. This is what grants access.
ADMIN_GITHUB_IDS=
# GitHub logins, for display only (shown on the refusal message). Never grants access.
ADMIN_GITHUB_LOGINS=

# Fine-grained token: only abelm10/AM_Portfolio, Contents read and write. Server-only.
GITHUB_CONTENT_TOKEN=
# Optional overrides; default to abelm10/AM_Portfolio and main.
GITHUB_REPO=
GITHUB_BRANCH=

# Optional: link shown after each save, e.g. https://vercel.com/<team>/<project>/deployments
VERCEL_DEPLOYMENTS_URL=

# Optional, local development only: "true" writes content files on disk instead of committing.
ADMIN_LOCAL_WRITES=
